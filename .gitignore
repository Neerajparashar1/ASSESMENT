.env
*.log
seb/generated/
scripts/__pycache__/
exports/

# Moodle runtime data (cache, sessions, secrets) - not source
moodledata/

# Local native stack: PHP/Apache/MariaDB/Moodle core + live DB data +
# generated configs are all re-downloaded/regenerated by
# native/Setup-MoodleNative.ps1 - none of it is source. Only the
# hand-written custom plugins under moodle/local/ are real project code
# and stay tracked.
native/stack/*
!native/stack/moodle
native/stack/moodle/*
!native/stack/moodle/local
native/stack/moodle/local/*
!native/stack/moodle/local/examwizard
!native/stack/moodle/local/uidesign
!native/stack/moodle/local/sebkiosk

# demo scripts leave these while a tunnel demo is live (the *-stop scripts remove them)
*.demobak
demo-url.txt

# Office lock / owner files
~$*
