a:207:{s:12:"accessdenied";s:13:"Access Denied";s:19:"action_upload_image";s:6:"Action";s:7:"actions";s:7:"Actions";s:19:"additional_settings";s:16:"General settings";s:9:"analyzbtn";s:7:"Analyze";s:16:"analyzbtnconfirm";s:52:"Click the Analyze button for face match of the user.";s:11:"analyzimage";s:14:"Analyze images";s:35:"areyousure_delete_all_course_record";s:126:"Are you sure you want to delete all images and records of students that were captured during the exams for <b>this course?</b>";s:28:"areyousure_delete_all_record";s:91:"Are you sure you want to delete all images of students that were captured during the exams?";s:23:"areyousure_delete_image";s:33:"Do you want to delete this image?";s:24:"areyousure_delete_record";s:44:"Are you sure you want to delete this record?";s:4:"back";s:4:"Back";s:19:"cancel_image_upload";s:22:"Cancelled image upload";s:21:"confirmdeletioncourse";s:53:"Are you sure you want to delete this course pictures?";s:19:"confirmdeletionquiz";s:58:"Are you sure you want to delete the pictures of this quiz?";s:25:"course_proctoring_summary";s:25:"Course Proctoring Summary";s:12:"dateverified";s:13:"Date and time";s:6:"delete";s:6:"Delete";s:18:"delete_images_task";s:18:"Delete images task";s:23:"delete_images_task_desc";s:28:"Delete all proctoring images";s:15:"deleteallcourse";s:20:"Delete course images";s:14:"deletequizdata";s:18:"Delete quiz images";s:5:"email";s:13:"Email address";s:35:"enable_web_camera_before_submitting";s:58:"You need to enable web camera before submitting this quiz!";s:18:"eprotroringreports";s:23:"Proctoring report for: ";s:22:"eprotroringreportsdesc";s:175:"In this report you will find all the images of the students which are taken during the exam. Now you can validate their identity, like their profile picture and webcam images.";s:20:"error_face_not_found";s:62:"Face not found in the image. Please contact the administrator.";s:20:"error_invalid_report";s:38:"Invalid report data. Please try again.";s:8:"examdata";s:101:"No data is available for this exam session. Please check the exam setup or monitoring configurations.";s:22:"execute_facematch_task";s:23:"Execute face match task";s:9:"facefound";s:33:"Face found in the uploaded image.";s:9:"facematch";s:56:"Face match successful. The student identity is verified.";s:11:"facematched";s:13:"Face matched.";s:10:"facematchs";s:88:"All images have been successfully analyzed. Please review them to verify the face match.";s:12:"facenotfound";s:37:"Face not found in the uploaded image.";s:17:"facenotfoundoncam";s:70:"Face not found. Try changing your camera to a better lighting. Thanks.";s:14:"facenotmatched";s:17:"Face not matched.";s:9:"foundtext";s:5:"Found";s:23:"identity_mismatch_label";s:17:"Identity Mismatch";s:5:"image";s:12:"Upload Image";s:18:"image_not_uploaded";s:46:"The uploaded image does not contain any faces.";s:13:"image_updated";s:13:"Image updated";s:12:"image_upload";s:12:"Upload image";s:16:"info:cameraallow";s:26:"Your camera is now in use.";s:23:"initiate_facematch_task";s:24:"Initiate face match task";s:28:"initiate_facematch_task_desc";s:74:"Initiates a face match task to compare images for proctoring verification.";s:11:"invalid_api";s:35:"The provided BS API key is invalid.";s:24:"invalid_facematch_method";s:107:"Invalid face match method in settings. Please provide valid "BS" API credentials for the face match method.";s:19:"invalid_service_api";s:39:"The provided BS service API is invalid.";s:10:"invalidapi";s:51:"BS API key is invalid. Please contact to the admin.";s:14:"invalidsesskey";s:38:"Invalid session key. Please try again.";s:11:"invalidtype";s:29:"The provided type is invalid.";s:19:"mainsettingspagebtn";s:19:"Proctoring settings";s:20:"modal:facevalidation";s:15:"Face validated:";s:13:"modal:pending";s:7:"Pending";s:18:"modal:validateface";s:25:"Validate face recognition";s:4:"name";s:12:"Student name";s:13:"no_permission";s:51:"You do not have proper permission to view this page";s:6:"no